# Local only. Never committed. In Netlify these are set with `npx netlify env:set`.

# --- Fabric read (service principal the AUTHOR holds; this is the point being tested) ---
FABRIC_SQL_ENDPOINT=<unique-id>.datawarehouse.fabric.microsoft.com   # Lakehouse/Warehouse > Settings > SQL endpoint > SQL connection string
FABRIC_DATABASE=<lakehouse-or-warehouse-item-name>                    # Initial Catalog
FABRIC_TABLE=dbo.<some_table>                                         # counted by /api/fabric
AZURE_TENANT_ID=<tenant-guid>
AZURE_CLIENT_ID=<app-registration-client-id>
AZURE_CLIENT_SECRET=<client-secret>

# --- Netlify DB ---
# NETLIFY_DATABASE_URL is injected by Netlify after `npx netlify database init`. Nothing to set here.

# --- App ---
APP_NAME=netlify-poc
