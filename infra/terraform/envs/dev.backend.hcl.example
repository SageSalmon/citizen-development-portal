# Copy to dev.backend.hcl (gitignored) and fill in the state storage account.
#   terraform init -backend-config=envs/dev.backend.hcl
resource_group_name  = "<REPLACE_WITH_TFSTATE_RESOURCE_GROUP>"
storage_account_name = "<REPLACE_WITH_TFSTATE_STORAGE_ACCOUNT>"
container_name       = "tfstate"
key                  = "citizen-development-portal.dev.tfstate"
use_azuread_auth     = true
