<mxfile host="app.diagrams.net" modified="2026-09-10T00:00:00.000Z" agent="draw.io" version="21.6.5" etag="gen" type="device" compressed="false"><diagram id="arch" name="Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Citizen app playground — architecture&lt;/b&gt; &amp;nbsp;·&amp;nbsp; thin slice built, first deploy pending, 2026-09-16 &amp;nbsp;·&amp;nbsp; &lt;i&gt;the skill suggests; the infrastructure enforces&lt;/i&gt; &amp;nbsp;·&amp;nbsp; dashed = planned" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c4" value="DEVELOPER LAPTOP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8A94A6;strokeWidth=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;spacingLeft=10;spacingTop=6;fontColor=#3E4C59;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="440" height="900" as="geometry"/></mxCell><mxCell id="c5" value="GITHUB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8A94A6;strokeWidth=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;spacingLeft=10;spacingTop=6;fontColor=#3E4C59;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="460" height="900" as="geometry"/></mxCell><mxCell id="c6" value="AZURE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8A94A6;strokeWidth=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;spacingLeft=10;spacingTop=6;fontColor=#3E4C59;" vertex="1" parent="1"><mxGeometry x="1020" y="70" width="700" height="900" as="geometry"/></mxCell><mxCell id="c7" value="USERS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8A94A6;strokeWidth=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;spacingLeft=10;spacingTop=6;fontColor=#3E4C59;" vertex="1" parent="1"><mxGeometry x="1760" y="70" width="180" height="900" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Claude Code + two skills&lt;/b&gt;&lt;br&gt;new-citizen-app (build) · deploy-citizen-app (deploy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3B52;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="380" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;App working copy — TypeScript + React on Functions&lt;/b&gt;&lt;br&gt;app.yaml · host.json · web/ (Vite) · server/ (handlers) · one-line workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3B52;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="380" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;scripts/check.mjs — vendored copy of the gate rules&lt;/b&gt;&lt;br&gt;npm run check · 7 rules · advisory, editable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2B6CB0;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="380" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Developer&amp;#x27;s gh login&lt;/b&gt;&lt;br&gt;the only credential on the laptop · cannot reach Azure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFA;strokeColor=#6B46C1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="380" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;KEY POINT — skill matches gates&lt;/b&gt;&lt;br&gt;Same rules, two copies. The skill vendors infra/gates into every app as check.mjs. Gate 2 runs the platform&amp;#x27;s copy and reports if the two differ. Every rule bites at exactly one gate (05, rule-to-gate map). A rule without a gate is a gap, not a control." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#B08900;strokeWidth=2;align=left;verticalAlign=middle;fontSize=11;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="70" y="600" width="380" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;DECIDED D32 — GitHub repo created at scaffold&lt;/b&gt;&lt;br&gt;new-citizen-app runs git init + gh repo create in SageSalmon before any code exists (D31, D32, 2026-09-16), and sets the repo OIDC subject template. The alternative (create on first deploy) was considered and not chosen. gh signed in to the org is the one prerequisite." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE2E2;strokeColor=#B42318;strokeWidth=2;align=left;verticalAlign=middle;fontSize=11;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="380" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;App repo  &amp;lt;org&amp;gt;/&amp;lt;app-name&amp;gt;&lt;/b&gt;&lt;br&gt;private · developer pushes main as themselves (D24) · workflow = one line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3B52;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="550" y="120" width="400" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Platform repo  citizen-development-portal&lt;/b&gt;&lt;br&gt;infra/gates (authoritative) · reusable workflow · terraform · apps/&amp;lt;name&amp;gt;.tf · fabric publisher · policy · dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3B52;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="550" y="230" width="400" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;GATE 1 — ADMISSION (manual today)&lt;/b&gt;&lt;br&gt;operator writes app-&amp;lt;name&amp;gt;.tf · terraform apply · infra/registry/&amp;lt;name&amp;gt;.json · owner/group/roles checks planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2B6CB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="400" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;GATE 2 — BUILD  (job A: runs app code, NO token)&lt;/b&gt;&lt;br&gt;lockfile · exact pins · release age · allow-list · audit · secret scan · host.json + healthz + signin · workflow call · vendored = platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2B6CB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="550" y="490" width="400" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;GATE 3 — DEPLOY  (job B: OIDC token, runs NO app code)&lt;/b&gt;&lt;br&gt;admitted? (registry) → az login OIDC → upload zip → anonymous /api/healthz must be refused (302/401). No rollback yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2B6CB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="400" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;KEY POINT — credential split (07)&lt;/b&gt;&lt;br&gt;Job A runs the developer&amp;#x27;s code and holds no token. Job B holds a minutes-long OIDC token for one app and runs no app code. No long-lived secret exists in GitHub or on the laptop. The deploy identity cannot widen what an app may do; only Terraform can." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#B08900;strokeWidth=2;align=left;verticalAlign=middle;fontSize=11;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="550" y="780" width="400" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Terraform apply&lt;/b&gt;&lt;br&gt;platform identity · from platform repo main only · creates per-app infra, roles, auth config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3B52;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;dashed=1;" vertex="1" parent="1"><mxGeometry x="1050" y="120" width="300" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Entra ID&lt;/b&gt;&lt;br&gt;built-in auth · access groups · per-app deploy + runtime identities · monitoring identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFA;strokeColor=#6B46C1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1390" y="120" width="300" height="80" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Azure Functions, Flex Consumption (one app per plan)&lt;/b&gt;&lt;br&gt;Node 24 handlers · scale to zero · Easy Auth in front, secretless (D33) · identity headers in · JSON logs out · 3 identities: runtime, auth, deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F0;strokeColor=#2F855A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1050" y="250" width="400" height="100" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Storage (no keys)&lt;/b&gt;&lt;br&gt;app package · MI access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F0;strokeColor=#2F855A;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1480" y="250" width="210" height="45" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Key Vault (planned)&lt;/b&gt;&lt;br&gt;secrets as references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F0;strokeColor=#2F855A;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;dashed=1;" vertex="1" parent="1"><mxGeometry x="1480" y="305" width="210" height="45" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;PostgreSQL (planned)&lt;/b&gt;&lt;br&gt;db + role per app · migration identity DDL · app DML only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F0;strokeColor=#2F855A;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;dashed=1;" vertex="1" parent="1"><mxGeometry x="1050" y="400" width="300" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Fabric workspace (planned)&lt;/b&gt;&lt;br&gt;lakehouse · notebooks · pipelines · ML · platform checks runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F0;strokeColor=#2F855A;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;dashed=1;" vertex="1" parent="1"><mxGeometry x="1390" y="400" width="300" height="80" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;logs · sign-ins · heartbeats · gate + check results · cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F0;strokeColor=#2F855A;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1050" y="530" width="300" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Health dashboard (planned)&lt;/b&gt;&lt;br&gt;platform tooling, not a playground app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F0;strokeColor=#2F855A;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;dashed=1;" vertex="1" parent="1"><mxGeometry x="1390" y="530" width="300" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;GATE 4 — RUNTIME (auth built; the rest planned)&lt;/b&gt;&lt;br&gt;auth always on · tags · heartbeat 15 min · weekly dependency rescan · daily data checks · monthly owner + roles ceiling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2B6CB0;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1050" y="650" width="640" height="80" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;KEY POINT (planned) — two data targets, one deploy path (08, 09)&lt;/b&gt;&lt;br&gt;Postgres and Fabric are both declared in data/, both applied by job B before the revision switch, both stop the deploy on failure. The app reads Postgres with a DML-only identity and Fabric as the signed-in user. Only platform identities change a schema or publish an item." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4B8;strokeColor=#B08900;strokeWidth=2;align=left;verticalAlign=middle;fontSize=11;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1050" y="780" width="640" height="110" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Citizen users&lt;/b&gt;&lt;br&gt;Entra sign-in · access group · no anonymous path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3B52;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;spacing=6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1780" y="120" width="140" height="80" as="geometry"/></mxCell><mxCell id="c32" value="scaffold, commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F3B52;fontColor=#2F3B52;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="npm run check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F3B52;fontColor=#2F3B52;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="git push main, as the developer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F3B52;fontColor=#2F3B52;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="vendored copy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2B6CB0;fontColor=#2B6CB0;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c15" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="admission PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F3B52;fontColor=#2F3B52;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="one-line call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F3B52;fontColor=#2F3B52;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2B6CB0;fontColor=#2B6CB0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2B6CB0;fontColor=#2B6CB0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="image digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2B6CB0;fontColor=#2B6CB0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="merge → apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2B6CB0;fontColor=#2B6CB0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="provisions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F3B52;fontColor=#2F3B52;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="identities, roles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2F3B52;fontColor=#2F3B52;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="OIDC, per app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6B46C1;fontColor=#6B46C1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.2;" edge="1" parent="1" source="c21" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="zip package" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2B6CB0;fontColor=#2B6CB0;fontSize=10;labelBackgrou